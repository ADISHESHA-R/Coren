# --- CORS / API base ---
# `npm run dev`: Vite loads `.env.development` (committed) → Render API proxy by default.
# Leave VITE_API_BASE_URL unset (or empty) while using `npm run dev` or `npm run preview`:
# the app calls same-origin `/api/...` and Vite proxies to the real backend (no browser CORS).

# Full API URL for production builds when the SPA is hosted on a different domain than the API.
# VITE_API_BASE_URL=https://backendclientapi.onrender.com

# Where Vite should forward `/api` in dev/preview (defaults to https://backendclientapi.onrender.com — see vite.config.js).
# Local backend example (restart Vite after changing):
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Other remote API:
# VITE_API_PROXY_TARGET=https://your-backend.onrender.com

# Dev only (`npm run dev`): respond 200 to POST /api/public/sites/*/customer-feedback without calling the proxy
# (use when your proxy target has no public route yet). Default is enabled in `.env.development`.
# VITE_DEV_STUB_PUBLIC_CUSTOMER_FEEDBACK=true
# VITE_DEV_STUB_PUBLIC_CUSTOMER_FEEDBACK=false

# --- Render Web Service (`npm start` / server/render-serve.mjs) ---
# At build time: bundle uses relative `/api` (no browser CORS when Node proxies).
# VITE_SAME_ORIGIN_API=true
# At runtime: where Node proxies `/api` to.
# API_PROXY_TARGET=https://backendclientapi.onrender.com

# --- Public customer feedback (no JWT) ---
# SPA route: /customer-feedback/{siteId} (no login). POST URL template for submit; use {siteId} placeholder.
# Default: feedback_json → POST { "feedbackJson": "{...}" } (matches admin GET payload shape).
# Use flat if your API expects the form fields at the root of the JSON body.
# VITE_PUBLIC_CUSTOMER_FEEDBACK_BODY_MODE=feedback_json
# VITE_PUBLIC_CUSTOMER_FEEDBACK_BODY_MODE=flat
