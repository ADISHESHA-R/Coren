# Loaded automatically by Vite in development (`npm run dev`).
# Browser calls same-origin `/api/*`; Vite proxies to this URL (no CORS).
# Override without editing this file: create `.env.development.local` with e.g.
#   VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_API_PROXY_TARGET=https://backendclientapi.onrender.com

# When true (default for local dev), Vite answers POST /api/public/sites/*/customer-feedback so the public form works without that route on the proxy target. Data is NOT stored — admin stays empty until your API implements the route.
# When false, POST goes to VITE_API_PROXY_TARGET; you need a real POST handler or you will see "No static resource".
VITE_DEV_STUB_PUBLIC_CUSTOMER_FEEDBACK=true
